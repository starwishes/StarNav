{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "rootDir": ".",
    "ignoreDeprecations": "6.0"
  },
  "include": ["server.ts", "src/server/**/*.ts", "src/server/**/*.d.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-server", "src/web", "tests", "clients/extension"]
}
