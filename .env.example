# Environment Variables Template for StarNav

# ===========================================
# Server Configuration
# ===========================================

# Admin account username (default: admin)
# The first user created will have admin privileges
ADMIN_USERNAME=admin

# Admin password — 请更换（仓库示例，勿用于公网）
# Prefer set explicitly. Empty outside Compose may create DATA_PATH/.admin_bootstrap_password
#   npm run admin:bootstrap-password
# Optional: ADMIN_BOOTSTRAP_PASSWORD_DELIVERY=file|log|both
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_PASSWORD_DELIVERY=

# JWT secret (min 32 chars) — 请更换；生成: openssl rand -base64 64
JWT_SECRET=

# ===========================================
# Network Configuration
# ===========================================

# Server port (default: 8080)
PORT=8080

# CORS allowed origins (comma-separated list for production)
# Leave empty to use the built-in localhost allowlist for local development
# Example: CORS_ORIGINS=https://nav.example.com,https://www.example.com
CORS_ORIGINS=

# Override the Secure flag for the web admin auth cookie.
# Leave empty to auto-detect from request protocol / X-Forwarded-Proto.
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SECURE=false

# Opt in to Helmet's upgrade-insecure-requests directive.
# Keep this disabled unless all external assets are already available over HTTPS.
# CSP_UPGRADE_INSECURE_REQUESTS=true

# ===========================================
# Application Settings
# ===========================================

# Node.js environment (development|production)
NODE_ENV=production

# Data directory path (default: ./data)
# This directory stores the SQLite database and uploaded files
# DATA_PATH=./data

# ===========================================
# Timezone
# ===========================================

# Single knob for container OS + admin UI display (session/audit tables).
# Allowed UI values: Asia/Shanghai, Asia/Tokyo, Europe/London, America/New_York,
# America/Los_Angeles, Europe/Moscow, Europe/Paris, Australia/Sydney
# (empty string = browser local for UI). DB 系统设置 timezone 优先于 TZ。
TZ=Asia/Shanghai

# ===========================================
# Docker / Compose Deployment
# ===========================================

# Published image repository and tag used by docker-compose.yml
STARNAV_IMAGE=ghcr.io/starwishes/starnav
STARNAV_TAG=latest
STARNAV_PORT=8080

# ===========================================
# Security Best Practices
# ===========================================

# 1. Always change JWT_SECRET to a random string in production
# 2. Prefer HTTPS in production, or forward X-Forwarded-Proto correctly behind a proxy
# 3. Set specific CORS_ORIGINS to prevent unauthorized access
# 4. Only force AUTH_COOKIE_SECURE when you know the deployment topology
# 5. Use strong ADMIN_PASSWORD (20+ characters recommended)
# 6. Regularly backup the data/starnav.db file or use `npm run db:backup`
# 7. Keep the container image updated and smoke-test upgrades before rollout

# ===========================================
# Docker Deployment Example
# ===========================================

# In docker-compose.yml:
#
# services:
#   starnav:
#     image: ${STARNAV_IMAGE}:${STARNAV_TAG}
#     container_name: starnav
#     ports:
#       - "${STARNAV_PORT}:8080"
#     volumes:
#       - ./data:/app/data
#     env_file:
#       - .env
#     restart: always
