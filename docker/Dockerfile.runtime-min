ARG NODE_IMAGE=node:24.14.1-slim
ARG RUNTIME_IMAGE=debian:bookworm-slim
ARG APT_DEBIAN_MIRROR=
ARG APT_DEBIAN_SECURITY_MIRROR=
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=

FROM ${NODE_IMAGE} AS build-stage
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
WORKDIR /app
COPY package*.json ./
# .npmrc 统一承载 peer-dep 策略（openapi-typescript peer ^5 vs 根 typescript ^6），
# 各阶段不再重复传 --legacy-peer-deps（第 16 轮审查）。
COPY .npmrc ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM ${NODE_IMAGE} AS prod-deps
WORKDIR /app
ARG APT_DEBIAN_MIRROR
ARG APT_DEBIAN_SECURITY_MIRROR
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
COPY package*.json ./
COPY .npmrc ./
RUN if [ -n "${APT_DEBIAN_MIRROR}" ] || [ -n "${APT_DEBIAN_SECURITY_MIRROR}" ]; then \
      DEBIAN_MIRROR="${APT_DEBIAN_MIRROR:-http://deb.debian.org/debian}"; \
      SECURITY_MIRROR="${APT_DEBIAN_SECURITY_MIRROR:-http://deb.debian.org/debian-security}"; \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i \
          -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
          -e "s|http://deb.debian.org/debian-security|${SECURITY_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
      fi; \
      if [ -f /etc/apt/sources.list ]; then \
        sed -i \
          -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
          -e "s|http://deb.debian.org/debian-security|${SECURITY_MIRROR}|g" \
          /etc/apt/sources.list; \
      fi; \
    fi
# hadolint ignore=DL3008
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends python3 make g++ && \
    npm ci --omit=dev --ignore-scripts && \
    npm rebuild better-sqlite3 && \
    apt-get purge -y --auto-remove python3 make g++ && \
    rm -rf /var/lib/apt/lists/* && \
    npm cache clean --force && \
    rm -rf /root/.npm /usr/local/share/.cache && \
    find node_modules -type f \( -name "*.md" -o -name "*.markdown" -o -name "LICENSE*" -o -name "CHANGELOG*" -o -name "*.map" -o \( -name "*.ts" -a ! -name "*.d.ts" \) \) -delete && \
    find node_modules -type d \( -name "test" -o -name "tests" -o -name "__tests__" -o -name "example" -o -name "examples" -o -name "demo" -o -name "docs" -o -name "coverage" \) -exec rm -rf {} +

FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /app
ARG APT_DEBIAN_MIRROR
ARG APT_DEBIAN_SECURITY_MIRROR
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

RUN if [ -n "${APT_DEBIAN_MIRROR}" ] || [ -n "${APT_DEBIAN_SECURITY_MIRROR}" ]; then \
      DEBIAN_MIRROR="${APT_DEBIAN_MIRROR:-http://deb.debian.org/debian}"; \
      SECURITY_MIRROR="${APT_DEBIAN_SECURITY_MIRROR:-http://deb.debian.org/debian-security}"; \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i \
          -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
          -e "s|http://deb.debian.org/debian-security|${SECURITY_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
      fi; \
      if [ -f /etc/apt/sources.list ]; then \
        sed -i \
          -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
          -e "s|http://deb.debian.org/debian-security|${SECURITY_MIRROR}|g" \
          /etc/apt/sources.list; \
      fi; \
    fi
# hadolint ignore=DL3008
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends ca-certificates dumb-init gosu libstdc++6 tzdata && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 node && \
    useradd --uid 1000 --gid 1000 --shell /usr/sbin/nologin --create-home node && \
    mkdir -p /app/data && \
    chown -R node:node /app

COPY --from=build-stage /usr/local/bin/node /usr/local/bin/node
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build-stage /app/dist ./dist
COPY package*.json ./
COPY server.ts ./
COPY tsconfig.server.json ./
COPY docker/docker-entrypoint.sh /usr/local/bin/
# 与 Dockerfile 保持一致的收窄 COPY：运行时只需 src/server + src/shared
COPY src/server ./src/server
COPY src/shared ./src/shared

# 生产容器以 tsx 执行 TS 源码（server.ts via tsx）是 AGENTS.md 记录的既定单进程架构。
# 取舍说明（第 16 轮审查记录）：tsc 预编译会引入独立 dist-server 产物、调整 COPY/CMD/
# 探针与镜像形态，改动面大且与既定设计冲突，故不采用；tsx/esbuild 以锁版本 +
# npm audit 覆盖其供应链面，TS 源码为私有部署自托管代码，暴露面可控。
# 注意：前端运行时库（vue 等）自第 16 轮起归 dependencies（audit:prod 覆盖），
# prod-deps 阶段安装的 node_modules 体积会相应增加；浏览器实际消费的是 dist 产物。

RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV NODE_ENV=production \
    PORT=8080 \
    DATA_PATH=/app/data \
    TZ=Asia/Shanghai

EXPOSE 8080

# 与 docker-compose.yml 探针保持一致（同步自 Dockerfile）
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
  CMD node -e "fetch('http://127.0.0.1:8080/api/health').then((res)=>process.exit(res.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["./node_modules/.bin/tsx", "server.ts"]
